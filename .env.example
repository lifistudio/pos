# ═══════════════════════════════════════════════════════════════════════════
# POS by lifistudio — variabel lingkungan
# Salin file ini menjadi `.env` lalu isi. Panduan lengkap (cara mendapatkan tiap nilai):
# menu Panduan › Pengaturan server (.env) di aplikasi, atau docs/PANDUAN-ENV.md.
# JANGAN commit `.env` dan jangan tempel isinya di chat, email, atau tiket.
# Aplikasi memeriksa semua nilai saat menyala; bila ada yang salah, aplikasi berhenti dan menyebut namanya.
# ═══════════════════════════════════════════════════════════════════════════

# Jumlah reverse proxy tepercaya di depan aplikasi (Traefik/Dokploy, Nginx = 1; Cloudflare + Nginx = 2; langsung tanpa proxy = 0).
# Salah mengisi membuat IP di audit log keliru dan rate limit per IP bisa dilewati. Bawaan: 1.
# TRUSTED_PROXY_HOPS=1

# ── 1. WAJIB ────────────────────────────────────────────────────────────────

# Mode aplikasi: development (komputer sendiri) | production (server sungguhan). Hosting biasanya mengisi ini otomatis.
# NODE_ENV=development

# Database PostgreSQL. Development: `pnpm db:start` menyalakan PostgreSQL lokal di port 5433 dengan nilai di bawah.
# Produksi: dari penyedia database (Neon, Supabase, VPS, …); tambahkan ?sslmode=require bila diwajibkan.
DATABASE_URL=postgres://pos:pos_dev_password@127.0.0.1:5433/pos

# Kunci rahasia login (≥ 32 karakter acak). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mengganti nilai ini = semua pengguna harus login ulang.
BETTER_AUTH_SECRET=

# Alamat aplikasi tanpa "/" di akhir. Development: http://localhost:3000. Produksi: https://pos.toko-anda.com
# Dipakai untuk cookie login, perlindungan CSRF, login OAuth aplikasi AI (MCP), dan URL kembali marketplace.
BETTER_AUTH_URL=http://localhost:3000

# ── 2. AKUN OWNER PERTAMA (dipakai `pnpm db:seed`) ──────────────────────────

SEED_OWNER_EMAIL=owner@pos.test
# Password ≥ 12 karakter di produksi. Hapus dari env setelah setup selesai.
SEED_OWNER_PASSWORD=
# Owner kedua (opsional, disarankan): saling bisa mengatur ulang password bila salah satu lupa dan SMTP belum ada.
# SEED_OWNER2_EMAIL=
# SEED_OWNER2_PASSWORD=
# true = buat cabang & produk contoh (default di development); false = hanya role, tier, Owner (default di production).
# SEED_DEMO=true

# ── 3. PEMBAYARAN QRIS DINAMIS (opsional) ───────────────────────────────────
# Tunai, QRIS statis, EDC (manual atau kabel), dan transfer TIDAK butuh pengaturan di sini.

# mock = simulator lokal untuk latihan (otomatis nonaktif di production; juga mengaktifkan EDC simulasi)
# midtrans | xendit | doku = QRIS dinamis sungguhan | none = tanpa QRIS dinamis
# Hanya gateway yang dipilih di sini yang membuat QR baru. Boleh mengganti kapan saja: QR lama tetap diproses
# selama kredensial gateway lamanya masih diisi. Panduan tiap gateway: docs/PANDUAN-PEMBAYARAN.md
PAYMENT_PROVIDER=mock
# Dari dashboard Midtrans › Settings › Access Keys › Server Key (sandbox atau production sesuai MIDTRANS_IS_PRODUCTION).
# MIDTRANS_SERVER_KEY=
# true = uang sungguhan, false = sandbox (uji coba).
# MIDTRANS_IS_PRODUCTION=false
# Alamat notifikasi pembayaran (HTTPS publik). Boleh juga diatur di dashboard Midtrans.
# PAYMENT_NOTIFICATION_URL=https://pos.toko-anda.com/api/payments/webhook/midtrans

# Xendit: Dashboard › Settings › API Keys (izin Money-In: Write). Test/live mengikuti jenis key.
# XENDIT_SECRET_KEY=
# Dashboard › Settings › Webhooks › Webhook verification token. Wajib: tanpa ini Xendit tidak aktif.
# XENDIT_WEBHOOK_TOKEN=

# DOKU QRIS (API SNAP): semua nilai dari DOKU Back Office setelah pendaftaran QRIS disetujui.
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# Private key RSA pasangan public key yang didaftarkan ke DOKU. Satu baris, ganti baris baru dengan \n.
# DOKU_PRIVATE_KEY=
# DOKU_MERCHANT_ID=
# DOKU_TERMINAL_ID=
# Kode pos toko, wajib di API QRIS DOKU.
# DOKU_POSTAL_CODE=
# true = uang sungguhan, false = sandbox.
# DOKU_IS_PRODUCTION=false

# Masa berlaku QR dalam menit (1–1440).
# QRIS_EXPIRY_MINUTES=15

# ── EMAIL (opsional): tanpa ini, tautan "Lupa password" tidak tampil ─────────
# Bisa memakai SMTP apa saja: Gmail (App Password), Brevo, Resend, Mailgun, SMTP hosting.
# SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (SMTP_SECURE=false), 465 = TLS langsung (SMTP_SECURE=true).
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Alamat pengirim, wajib bersama SMTP_HOST.
# SMTP_FROM="POS by lifistudio <no-reply@toko-anda.com>"

# ── 4. GAMBAR & MEDIA — CLOUDINARY (disarankan di produksi) ─────────────────
# Kosongkan ketiganya = gambar disimpan di database (cukup untuk mencoba/toko kecil).
# Dari Cloudinary Console › Settings › API Keys.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Folder di Media Library Cloudinary.
# CLOUDINARY_FOLDER=pos-lifistudio

# ── 5. MARKETPLACE (opsional) ───────────────────────────────────────────────
# Shopee Open Platform (open.shopee.com): Partner ID & Partner Key aplikasi Anda. Langkahnya: Panduan › Integrasi marketplace.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# sandbox | live
# SHOPEE_ENV=sandbox
# TikTok Shop / Tokopedia (partner.tiktokshop.com): App Key, App Secret, Service ID. Langkahnya: Panduan › Integrasi marketplace.
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# TIKTOK_SERVICE_ID=
# Kunci enkripsi token toko marketplace (≥ 32 karakter acak; disarankan diisi bila memakai marketplace).
# Default: diturunkan dari BETTER_AUTH_SECRET. Jangan diganti setelah toko terhubung (toko harus dihubungkan ulang).
# MARKETPLACE_SECRET=

# ── 6. PENGEMBANGAN (tidak dipakai di produksi) ─────────────────────────────

# Matikan telemetry CLI BoardUI saat build.
BOARDUI_TELEMETRY_DISABLED=1
# 1 = tampilkan query SQL di log server (untuk mencari query lambat). Jangan aktif di produksi.
# DB_LOG_QUERIES=1
# Akun kasir uji untuk pengujian alur kasir & PIN (dibuat manual di Pengaturan › Pengguna).
# TEST_KASIR_EMAIL=
# TEST_KASIR_PASSWORD=

# ── Tidak perlu env ─────────────────────────────────────────────────────────
# Printer struk, mesin EDC, dan layar pelanggan diatur per perangkat kasir di aplikasi (Kasir › Perangkat).
# Login OAuth aplikasi AI (Claude, ChatGPT) memakai BETTER_AUTH_URL; API key dibuat di Pengaturan › API key & MCP.
