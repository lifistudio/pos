{
  "name": "konten-pos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Aplikasi kasir (POS) & back-office open source untuk usaha multi-cabang",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "audit:deps": "pnpm audit --prod",
    "check:pricing": "tsx scripts/checks/pricing.check.ts",
    "check:marketplace": "tsx --conditions=react-server scripts/checks/tiktok.check.mts",
    "check:media": "tsx --conditions=react-server scripts/checks/cloudinary.check.mts",
    "check:barcode": "tsx scripts/checks/barcode.check.ts",
    "check:ecr": "tsx scripts/checks/ecr.check.ts",
    "check:oauth": "tsx scripts/checks/oauth.check.ts",
    "check:receipt": "tsx scripts/checks/receipt.check.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@internationalized/date": "3.12.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remixicon/react": "^4.9.0",
    "@scalar/hono-api-reference": "^0.12.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "motion": "12.42.2",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "recharts": "3.9.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.19.0"
}
