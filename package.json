{
  "name": "pos-by-lifistudio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Aplikasi kasir (POS) & back-office open source untuk usaha multi-cabang",
  "author": "lifistudio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifistudio/pos.git"
  },
  "homepage": "https://github.com/lifistudio/pos#readme",
  "bugs": {
    "url": "https://github.com/lifistudio/pos/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local": "node scripts/start-local.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "audit:deps": "pnpm audit --prod",
    "check:pricing": "tsx scripts/checks/pricing.check.ts",
    "check:marketplace": "tsx --conditions=react-server scripts/checks/tiktok.check.mts && tsx --conditions=react-server scripts/checks/shopee.check.mts",
    "check:payments": "tsx --conditions=react-server scripts/checks/payments.check.mts",
    "check:media": "tsx --conditions=react-server scripts/checks/cloudinary.check.mts",
    "check:barcode": "tsx scripts/checks/barcode.check.ts",
    "check:ecr": "tsx scripts/checks/ecr.check.ts",
    "check:oauth": "tsx scripts/checks/oauth.check.ts",
    "check:receipt": "tsx scripts/checks/receipt.check.ts",
    "check:flows": "tsx --conditions=react-server scripts/checks/flows.check.mts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@internationalized/date": "3.12.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remixicon/react": "^4.9.0",
    "@scalar/hono-api-reference": "^0.12.17",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.105.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "motion": "14.9.0",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "postgres": "^4.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.16.1"
}
